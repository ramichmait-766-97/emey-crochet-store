{
  "name": "emey-crochet-store",
  "version": "1.1.1",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "firebase": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (Split-Path -LiteralPath $env:npm_package_json) 'scripts/firebase.ps1')\"",
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test:auth": "node --test scripts/auth-navigation.test.mjs",
    "test": "node --test scripts/auth-navigation.test.mjs scripts/storefront.test.mjs scripts/live-catalog.test.mjs scripts/seed-products.test.mjs",
    "format": "prettier --write \"{src,functions}/**/*.{ts,html,scss,mjs,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,functions}/**/*.{ts,html,scss,mjs,json}\" \"*.{json,md}\"",
    "functions:install": "npm --prefix functions install",
    "functions:build": "npm --prefix functions run build",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy": "npm run build:prod && npm run functions:build && firebase deploy",
    "admin:set": "node functions/scripts/set-admin.mjs",
    "products:seed": "node scripts/run-products-seed.cjs",
    "productseed": "node -e \"require(require('path').join((process.env.npm_package_json ? require('path').dirname(process.env.npm_package_json) : process.env.INIT_CWD), 'scripts/run-products-seed.cjs'))\" -- productseed --local-copy",
    "firebase:login": "node scripts/run-products-seed.cjs --login",
    "users:seed": "node functions/scripts/seed-users.mjs",
    "firebase:deploy:free": "npm run build:prod && firebase deploy --project emey-crochet-store --only hosting,firestore:rules"
  },
  "dependencies": {
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/forms": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@angular/router": "^20.3.33",
    "firebase": "12.19.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/cli": "^20.3.39",
    "@angular/compiler-cli": "^20.3.33",
    "firebase-tools": "^15.30.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "@angular/build": "^20.3.39"
  }
}
